{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A2UI Precision Oncology Component Catalog",
  "version": "1.1.0",
  "description": "Non-executable declarative UI component catalog for Cancer Co-Scientist (DOC-03 compliant)",
  "components": {
    "InsightCard": {
      "description": "Card highlighting key oncological finding or therapeutic recommendation",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "success", "warning", "critical"] },
        "summary": { "type": "string" },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "summary"]
    },
    "KnowledgeGraphView": {
      "description": "Interactive biomedical knowledge graph visualization (PrimeKG subgraph)",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string", "enum": ["Gene", "Disease", "Drug", "Pathway", "Phenotype"] },
              "name": { "type": "string" },
              "properties": { "type": "object" }
            },
            "required": ["id", "label", "name"]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": { "type": "string" },
              "target_id": { "type": "string" },
              "relationship": { "type": "string" },
              "confidence": { "type": "number" },
              "evidence_source": { "type": "string" }
            },
            "required": ["source_id", "target_id", "relationship"]
          }
        },
        "layout": { "type": "string", "enum": ["force-directed", "hierarchical", "circular"], "default": "force-directed" }
      },
      "required": ["nodes", "edges"]
    },
    "PathwayChart": {
      "description": "Biochemical signaling pathway cascade with dysregulation metrics",
      "properties": {
        "pathway_id": { "type": "string" },
        "pathway_name": { "type": "string" },
        "dysregulation_status": { "type": "string", "enum": ["upregulated", "downregulated", "mutated"] },
        "genes_involved": { "type": "array", "items": { "type": "string" } },
        "targetable_nodes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["pathway_id", "pathway_name"]
    },
    "DrugRepurposingTable": {
      "description": "Ranked therapeutic candidates with mechanism, phase, and evidence",
      "properties": {
        "title": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "drug_id": { "type": "string" },
              "drug_name": { "type": "string" },
              "target_gene": { "type": "string" },
              "clinical_phase": { "type": "string" },
              "mechanism": { "type": "string" },
              "confidence": { "type": "number" }
            },
            "required": ["drug_id", "drug_name", "target_gene"]
          }
        }
      },
      "required": ["candidates"]
    },
    "EvidenceDrawer": {
      "description": "Collapsible evidence panel with citations, PubMed IDs, and clinical trial records",
      "properties": {
        "title": { "type": "string" },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pubmed_id": { "type": "string" },
              "title": { "type": "string" },
              "year": { "type": "integer" },
              "snippet": { "type": "string" }
            },
            "required": ["pubmed_id", "title"]
          }
        }
      },
      "required": ["citations"]
    },
    "MemoryTimeline": {
      "description": "Displays extracted clinical entities, biomarkers, and hypotheses across conversation turns (PAT-MEM-BANK)",
      "properties": {
        "title": { "type": "string" },
        "session_id": { "type": "string" },
        "total_turns": { "type": "integer" },
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "turn_number": { "type": "integer" },
              "timestamp": { "type": "string" },
              "user_query": { "type": "string" },
              "extracted_entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string", "enum": ["Gene", "Variant", "Disease", "Drug", "Biomarker", "Pathway"] },
                    "confidence": { "type": "number" }
                  },
                  "required": ["name", "type"]
                }
              },
              "hypotheses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "statement": { "type": "string" },
                    "status": { "type": "string", "enum": ["formulated", "testing", "confirmed", "refuted"] },
                    "confidence": { "type": "number" }
                  },
                  "required": ["statement", "status"]
                }
              },
              "summary": { "type": "string" }
            },
            "required": ["turn_number", "user_query"]
          }
        },
        "active_biomarkers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confirmed_hypotheses_count": { "type": "integer" }
      },
      "required": ["turns"]
    },
    "SimulationViewer": {
      "description": "3D/continuous trajectory viewer for AlphaFold docking paths (OMPL) or cellular swarming density (PhysiCell)",
      "properties": {
        "simulation_id": { "type": "string" },
        "title": { "type": "string" },
        "simulation_type": {
          "type": "string",
          "enum": ["AlphaFold_Docking_OMPL", "Cellular_Swarming_PhysiCell", "Molecular_Dynamics"]
        },
        "target_protein": { "type": "string" },
        "ligand_name": { "type": "string" },
        "trajectory_frames": { "type": "integer" },
        "current_frame": { "type": "integer" },
        "metrics": {
          "type": "object",
          "properties": {
            "binding_affinity_kcal_mol": { "type": "number" },
            "rmsd_angstrom": { "type": "number" },
            "clash_score": { "type": "number" },
            "cell_density_confluence_pct": { "type": "number" }
          }
        },
        "view_config": {
          "type": "object",
          "properties": {
            "camera_preset": { "type": "string", "enum": ["default", "binding_pocket", "active_site", "cellular_mesh"] },
            "render_style": { "type": "string", "enum": ["cartoon", "surface", "stick_ball", "density_field"] },
            "color_scheme": { "type": "string", "enum": ["chain", "bfactor", "hydrophobicity", "custom"] }
          }
        },
        "trajectory_data_url": { "type": "string" }
      },
      "required": ["simulation_id", "title", "simulation_type"]
    },
    "ToxicityWarning": {
      "description": "Displays contraindications, adverse reactions, and clinical warnings",
      "properties": {
        "drug_name": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "moderate", "high", "critical", "black_box"]
        },
        "warning_type": {
          "type": "string",
          "enum": ["Contraindication", "Black Box Warning", "Drug-Drug Interaction", "Organ Toxicity", "Adverse Reaction"]
        },
        "message": { "type": "string" },
        "contraindicated_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interacting_drugs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "adverse_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "effect": { "type": "string" },
              "frequency": { "type": "string" },
              "severity": { "type": "string" }
            },
            "required": ["effect"]
          }
        },
        "clinical_recommendation": { "type": "string" }
      },
      "required": ["drug_name", "severity", "message"]
    }
  }
}
